    {
      "idx": 4,
      "text": "Заполучив систему «Космо-реверс», экипаж оставляет"
    },
    {
      "idx": 5,
      "text": "Искандар позади и через уцелевшие врата варпа на планете"
    },
    {
      "idx": 6,
      "text": "Балун спешит вернуться к Земле."
    },
    {
      "idx": 8,
      "text": "По ту сторону их ждёт последняя битва."
    }
  ]
}
