    {
      "idx": 4,
      "text": "«Космо-реверс» остановил слияние пространства-времени,"
    },
    {
      "idx": 5,
      "text": "и все Земли стали заново проживать свои истории."
    },
    {
      "idx": 8,
      "text": "Экипаж же приготовился встретить новое будущее."
    }
  ]
}
