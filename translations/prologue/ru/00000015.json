    {
      "idx": 3,
      "text": "Уйдя от атак Альянса ДГ, отряд «Надэсико» готовится"
    },
    {
      "idx": 4,
      "text": "начать решительный штурм передовой базы"
    },
    {
      "idx": 5,
      "text": "Наследников Марса."
    },
    {
      "idx": 6,
      "text": "Тем временем Анж и её товарищи, получив просьбу Жасмин,"
    },
    {
      "idx": 7,
      "text": "ненадолго возвращаются в Арзенал."
    }
  ]
}
