  "lines": [
    {
      "idx": 3,
      "text": "Отряд «Надэсико», приютивший Кодая и других беглецов"
    },
    {
      "idx": 4,
      "text": "с «Ямато», завершает последние приготовления"
    },
    {
      "idx": 5,
      "text": "к захвату терминальной колонии Аматэрасу."
    },
    {
      "idx": 6,
      "text": "Тем временем Каппэй оттачивает мастерство на симуляторе,"
    },
    {
      "idx": 7,
      "text": "готовясь к решающему поединку с Майто."
    }
  ]
}
