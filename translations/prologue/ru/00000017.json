  "lines": [
    {
      "idx": 3,
      "text": "Хэтэуэй, пилот-испытатель новейшего Ξ-Гандама,"
    },
    {
      "idx": 4,
      "text": "направлен на борт «Туата де Данан», чтобы собрать"
    },
    {
      "idx": 5,
      "text": "данные о работе системы «Миновски-крафт»."
    },
    {
      "idx": 7,
      "text": "Чем дольше тянется подводное плавание, тем сильнее"
    },
    {
      "idx": 8,
      "text": "в нём закипает накопившееся раздражение."
    }
  ]
}
