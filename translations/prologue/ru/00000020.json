  "lines": [
    {
      "idx": 3,
      "text": "Окружённые Нео-Зеоном, «Джи-Хаундом», Доктором Хеллом"
    },
    {
      "idx": 4,
      "text": "и Ангелами, отважные герои укрываются в Японии,"
    },
    {
      "idx": 5,
      "text": "выжидая момент для контрнаступления."
    },
    {
      "idx": 6,
      "text": "Тем временем преступники замышляют посеять хаос,"
    },
    {
      "idx": 7,
      "text": "пользуясь тревожной обстановкой этих дней."
    }
  ]
}
