  "lines": [
    {
      "idx": 3,
      "text": "По приказу штаба армии Федерации Земли"
    },
    {
      "idx": 4,
      "text": "уступающий числом «Джи-Хаунд» выходит в космос."
    },
    {
      "idx": 5,
      "text": "Их замысел — переломить ход войны: захватить"
    },
    {
      "idx": 6,
      "text": "колониальный лазер и с его помощью раз и навсегда"
    },
    {
      "idx": 7,
      "text": "покончить с бушующей галактической войной."
    }
  ]
}
