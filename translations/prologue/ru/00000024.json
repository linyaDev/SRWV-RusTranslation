  "lines": [
    {
      "idx": 3,
      "text": "«Лапласу», союзной организации Федерации Земли"
    },
    {
      "idx": 4,
      "text": "и Нео-Зеона, доверена сила, способная положить"
    },
    {
      "idx": 5,
      "text": "конец войне."
    },
    {
      "idx": 6,
      "text": "Пока вершится обдумывание грядущих сражений,"
    },
    {
      "idx": 7,
      "text": "Пле, Пле Два и Марида вновь вместе и наслаждаются"
    },
    {
      "idx": 8,
      "text": "краткой передышкой между боями."
    }
  ]
}
