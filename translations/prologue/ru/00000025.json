  "lines": [
    {
      "idx": 3,
      "text": "Команда из измерения AD прощается с друзьями"
    },
    {
      "idx": 4,
      "text": "и близкими перед отбытием к Искандару, где им"
    },
    {
      "idx": 5,
      "text": "предстоит остановить слияние пространства-времени."
    },
    {
      "idx": 6,
      "text": "Урибатакэ звонит Садзи Кроссроуду, управляющему"
    },
    {
      "idx": 7,
      "text": "его заводами в отсутствие хозяина. Он и не ведает,"
    },
    {
      "idx": 8,
      "text": "что к его драгоценному предприятию уже подползает"
    },
    {
      "idx": 9,
      "text": "зловещая тень."
    }
  ]
}
